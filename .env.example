# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration for Video Captioning App
# ─────────────────────────────────────────────────────────────────────────────
# 
# SECURITY: Never commit the actual .env file to version control!
# This file contains placeholder values only.
# Copy this to .env and fill in your actual values.

# ── API Keys ────────────────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Fireworks AI for fallback/alternative LLM
FIREWORKS_API_KEY=your-fireworks-api-key-here
FIREWORKS_LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# ── Video Processing Settings ──────────────────────────────────────────────
FRAME_COUNT=5
ENABLE_SCENE_DETECTION=true
ENABLE_AUDIO_TRANSCRIPT=false

# ── Generation Settings ────────────────────────────────────────────────────
TEMPERATURE=0.2
TOP_P=0.8
MAX_OUTPUT_TOKENS=2048

# ── Deployment Configuration ────────────────────────────────────────────────
# deployment environment: development, staging, production
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
# Leave empty to use sensible defaults based on ENVIRONMENT
# Examples:
#   Development: http://localhost:5173, http://localhost:3000
#   Production: https://myapp.vercel.app, https://api.example.com
CORS_ORIGINS=

# ── I/O Paths (used by batch processing) ────────────────────────────────────
INPUT_TASKS_PATH=/input/tasks.json
OUTPUT_RESULTS_PATH=/output/results.json

# ── Optional Settings ────────────────────────────────────────────────────────
MAX_WORKERS=3

