{
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "nodeVersion": "18.x",
  "env": {
    "VITE_API_BASE_URL": {
      "description": "Backend API base URL (e.g., https://video-captioning-api.onrender.com)",
      "required": true
    }
  },
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "https://video-captioning-api.onrender.com/api/:path*",
      "permanent": false
    }
  ]
}
